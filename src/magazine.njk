---
layout: base.njk
title: "Magazine · Mudun Lab"
description: "Essays, opinion, and photography on cities in Jordan, the human, everyday side of urban life. Open to writers, photographers, and researchers."
---
{% import "entry-card.njk" as cardlib %}
  <section class="view active" id="view-magazine">
    <div class="wrap">
      <div class="sec-head">
        <h2 data-en="Stories about the city" data-ar="حكاياتٌ عن المدينة"></h2>
        <p class="lede" style="margin-top:1rem"
           data-en="Essays, opinion and photography about everyday life in Jordan's cities. Shorter and more personal than the research, and open to contributors."
           data-ar="مقالاتٌ وآراءٌ وصورٌ عن الحياة اليومية في مدن الأردن. أقصر من الأبحاث وأقرب إلى التجربة الشخصية، ومفتوحةٌ للمساهمين."></p>
      </div>

      {# Only show filters for categories that actually have a piece, and only when there's more than one #}
      {% set used = [] %}
      {% for e in collections.magazine %}{% if e.data.category not in used %}{% set used = (used.push(e.data.category), used) %}{% endif %}{% endfor %}
      {% if used.length > 1 %}
      <div class="filters" data-filter-group aria-label="Categories">
        <button class="chip active" data-filter="all" data-en="All" data-ar="الكل"></button>
        {% for key, c in categories.magazine %}{% if key in used %}<button class="chip" data-filter="{{ key }}" data-en="{{ c.en }}" data-ar="{{ c.ar }}"></button>{% endif %}{% endfor %}
      </div>
      {% endif %}

      <div class="entries">
{% for entry in collections.magazine %}{{ cardlib.card(entry, "magazine", categories) }}{% endfor %}
      </div>

      <p style="margin-top:26px;color:var(--asphalt-soft);max-width:60ch"
         data-en="Have a story, an essay, or photographs of the city? The magazine is open."
         data-ar="ألديك حكاية أو مقال أو صورٌ للمدينة؟ المجلّة مفتوحة."></p>
      <a class="btn btn-ghost" href="/publish/" style="margin-top:6px" data-en="Contribute to the magazine" data-ar="شارك في المجلّة"></a>
    </div>
  </section>
