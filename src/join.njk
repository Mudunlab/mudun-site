---
layout: base.njk
title: "Join · Mudun Lab"
description: "Add your name to Mudun Lab. Membership is free, and we get in touch when a survey, field day or call for writers needs people."
---
  <section class="view active" id="view-join">
    <div class="wrap">
      <div class="invite">
        <div class="label" data-en="Membership" data-ar="العضوية"></div>
        <h2 data-en="Membership is free." data-ar="العضوية مجّانية."></h2>
        <p data-en="There's no fee and nothing to buy. Adding your name tells us you care about how Jordan's cities are built, and lets us reach you when a project needs people: a survey, a field day, or a call for writers."
           data-ar="لا رسوم ولا شيء للشراء. بإضافة اسمك تخبرنا أنك تهتمّ بالطريقة التي تُبنى بها مدن الأردن، وتتيح لنا التواصل معك حين يحتاج مشروعٌ إلى مشاركين: استبيان، أو يوم ميداني، أو دعوة للكتابة."></p>
      </div>

      <div class="sec-head" style="margin-bottom:24px">
        <h2 data-en="Add your name" data-ar="أضف اسمك"></h2>
      </div>

      <form class="form-wrap" id="joinForm" action="https://formspree.io/f/maqgznql" method="POST" novalidate>
        <div class="field"><label for="j-name" data-en="Full name" data-ar="الاسم الكامل"></label><input id="j-name" type="text" name="name" required data-en-ph="Your name" data-ar-ph="اسمك"></div>
        <div class="field"><label for="j-email" data-en="Email" data-ar="البريد الإلكتروني"></label><input id="j-email" type="email" name="email" required data-en-ph="you@example.com" data-ar-ph="you@example.com"></div>
        <div class="field"><label for="j-city" data-en="City" data-ar="المدينة"></label><input id="j-city" type="text" name="city" data-en-ph="Amman" data-ar-ph="عمّان"></div>
        <div class="field"><label for="j-prof" data-en="Profession / field of study" data-ar="المهنة / مجال الدراسة"></label><input id="j-prof" type="text" name="profession" data-en-ph="e.g. urban planning, architecture, engineering, student" data-ar-ph="مثلاً: التخطيط الحضري، العمارة، الهندسة، طالب"></div>
        <div class="field">
          <label id="j-involvement-label" data-en="How would you like to be involved?" data-ar="كيف تودّ أن تشارك؟"></label>
          <div class="checks" role="group" aria-labelledby="j-involvement-label">
            <label class="check"><input type="checkbox" name="involvement" value="Writing & research"><span data-en="Writing & research" data-ar="الكتابة والبحث"></span></label>
            <label class="check"><input type="checkbox" name="involvement" value="Volunteering"><span data-en="Volunteering" data-ar="التطوّع"></span></label>
            <label class="check"><input type="checkbox" name="involvement" value="Data collection"><span data-en="Data collection" data-ar="جمع البيانات"></span></label>
            <label class="check"><input type="checkbox" name="involvement" value="Photography & mapping"><span data-en="Photography & mapping" data-ar="التصوير ورسم الخرائط"></span></label>
            <label class="check"><input type="checkbox" name="involvement" value="Events"><span data-en="Events" data-ar="الفعاليات"></span></label>
            <label class="check"><input type="checkbox" name="involvement" value="Just here to support"><span data-en="Just here to support" data-ar="هنا للدعم فقط"></span></label>
          </div>
        </div>
        <div class="field"><label for="j-why" data-en="Why do you want to join? (optional)" data-ar="لماذا تودّ الانضمام؟ (اختياري)"></label><textarea id="j-why" name="why" data-en-ph="A sentence or two, if you'd like." data-ar-ph="جملة أو جملتان، إن أحببت."></textarea></div>
        <button type="submit" class="btn btn-primary" data-en="Add my name" data-ar="أضف اسمي"></button>
        <p class="privacy" data-en="We'll only contact you about Mudun Lab projects you might want to join. We won't share your details with anyone." data-ar="لن نتواصل معك إلا بشأن مشاريع مدن لاب التي قد تهمّك، ولن نشارك بياناتك مع أحد."></p>
      </form>
      <div class="form-ok" id="joinOk">
        <h3 data-en="Thanks, you're on the list." data-ar="شكرًا، أصبح اسمك على القائمة."></h3>
        <p data-en="We'll be in touch when there's something you can take part in." data-ar="سنتواصل معك حين يكون هناك ما يمكنك المشاركة فيه."></p>
      </div>
    </div>
  </section>
