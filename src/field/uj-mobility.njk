<style>
  .uj-hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(24px,4vw,56px);align-items:center}
  .uj-hero h1{font-size:clamp(2rem,4.4vw,3.2rem);line-height:1.12;margin:.6rem 0 1rem;text-wrap:balance}
  .uj-hero h1 em{font-style:normal;color:var(--green-deep)}
  .uj-hero .partners{margin-top:1.1rem;font-size:.9rem;color:var(--asphalt-soft)}
  .uj-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:1.6rem}
  .uj-cta .btn-primary{font-size:1.05rem;padding:.85em 1.5em}
  .uj-poster{justify-self:center;width:100%;max-width:300px;border-radius:10px;border:1px solid var(--sand-line);box-shadow:0 18px 40px rgba(35,35,35,.14);display:block;height:auto}
  .uj-phone{justify-self:center;width:100%;max-width:260px;border-radius:28px;border:6px solid var(--asphalt);box-shadow:0 18px 40px rgba(35,35,35,.18);display:block}
  .uj-tags{display:flex;flex-wrap:wrap;gap:8px}
  .uj-tags span{font-size:.78rem;font-weight:600;border-radius:999px;padding:.3em .8em;background:var(--limestone);color:var(--asphalt-soft)}
  .uj-tags span.live{background:var(--green-deep);color:#fff}
  .uj-sec{margin-top:clamp(48px,7vw,84px)}
  .uj-sec h2{font-size:clamp(1.5rem,3vw,2.1rem);margin:.5rem 0 .6rem}
  .uj-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:1.4rem;counter-reset:s}
  .uj-steps div{background:var(--paper);border:1px solid var(--sand-line);border-radius:12px;padding:18px}
  .uj-steps b{display:block;font-family:var(--font-display);font-size:1.05rem;margin-bottom:.35rem}
  .uj-steps p{margin:0;color:var(--asphalt-soft);font-size:.95rem}
  .uj-walls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:1.4rem}
  .uj-wall{background:var(--paper);border:1px solid var(--sand-line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:12px}
  .uj-wall img{width:100%;border-radius:10px;aspect-ratio:1170/2532;object-fit:cover;object-position:50% 55%;background:var(--limestone);max-height:420px}
  .uj-wall h3{font-size:1.05rem;margin:0}
  .uj-wall .btn{justify-content:center}
  .uj-maps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:1.4rem}
  .uj-map{background:var(--paper);border:1px solid var(--sand-line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px}
  .uj-map img{width:100%;height:auto;border-radius:8px;border:1px solid var(--sand-line);display:block;background:var(--limestone)}
  .uj-map h3{font-size:1.05rem;margin:0}.uj-map p{margin:0;color:var(--asphalt-soft);font-size:.9rem}
  .uj-map-btns{display:flex;gap:8px;margin-top:auto}.uj-map-btns .btn{flex:1;justify-content:center}
  .uj-prints{display:flex;flex-direction:column;gap:10px;margin-top:1.2rem;max-width:720px}
  .uj-print{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:var(--paper);border:1px solid var(--sand-line);border-radius:12px;padding:14px 16px}
  .uj-print b{font-family:var(--font-display)}
  .uj-print small{display:block;color:var(--asphalt-soft);font-size:.85rem;margin-top:2px}
  .uj-note{margin-top:1rem;font-size:.9rem;color:var(--asphalt-soft);max-width:62ch}
  .uj-box{background:var(--limestone);border-radius:14px;padding:clamp(18px,3vw,28px);max-width:760px}
  .uj-box p{margin:.4rem 0 0;color:var(--asphalt-soft)}
  @media (max-width:820px){.uj-hero{grid-template-columns:1fr}.uj-phone{max-width:220px}.uj-poster{max-width:240px}.uj-steps,.uj-walls,.uj-maps{grid-template-columns:1fr}.uj-wall img{max-height:360px}}
</style>
  <section class="view active" id="view-uj">
    <div class="wrap">
      <a class="label" href="/field/" style="text-decoration:none" data-en="← Field" data-ar="الميدان ←"></a>

      <div class="uj-hero" style="margin-top:1.2rem">
        <div>
          <div class="uj-tags">
            <span class="live" data-en="Open now" data-ar="مفتوح الآن"></span>
            <span data-en="Booth at UJ · 3 Nov 2026" data-ar="جناح في الجامعة الأردنية · ٣ تشرين الثاني ٢٠٢٦"></span>
          </div>
          <h1><span data-en="How do you get to" data-ar="كيف بتوصل"></span> <em data-en="the University of Jordan?" data-ar="للجامعة الأردنية؟"></em></h1>
          <p class="lede"
             data-en="Draw your trip on the map in two minutes: where you start, which lines you take, how long you wait. See it next to every other student's trip, and download free bus maps."
             data-ar="ارسم رحلتك على الخريطة في دقيقتين: من وين بتطلع، أي خطوط بتركب، وقدّيش بتستنى. شوف رحلتك جنب رحلات باقي الطلاب، ونزّل خرائط الباصات مجاناً."></p>
          <div class="uj-cta">
            <a class="btn btn-primary" href="/uj/"><span data-en="Draw your trip" data-ar="ارسم رحلتك"></span><span class="arrow">→</span></a>
            <a class="btn btn-ghost" href="#maps" data-en="Free maps" data-ar="خرائط مجانية"></a>
          </div>
          <p class="partners" data-en="A Mobility with Confidence initiative with Mudun Lab, in partnership with Amman Vision."
             data-ar="مبادرة تنقّل بثقة مع مدن لاب، بالشراكة مع رؤية عمّان."></p>
          <img src="/uploads/field/uj/vision-city-bus-logo.png" alt="Vision City Bus" style="height:40px;width:auto;margin-top:.7rem;display:block">
        </div>
        <img class="uj-poster" src="/uploads/field/uj/map-amman-lines-thumb.jpg" alt="Map of Amman bus lines to the University of Jordan" width="422" height="597">
      </div>

      <div class="uj-sec">
        <span class="label" data-en="The survey" data-ar="الاستبيان"></span>
        <h2 data-en="A survey you draw" data-ar="استبيان بترسمه"></h2>
        <div class="uj-steps">
          <div><b data-en="1 · Start at home" data-ar="١ · ابدأ من البيت"></b><p data-en="Search your area or street, then tap roughly where you live. We store it rounded to about 200 m." data-ar="ابحث عن منطقتك أو شارعك واضغط تقريباً مكان بيتك. بنحفظه بشكل تقريبي (حوالي ٢٠٠ متر)."></p></div>
          <div><b data-en="2 · Draw each leg" data-ar="٢ · ارسم كل مرحلة"></b><p data-en="Walk, bus, BRT, coaster or service taxi: add each part of the trip with how long you waited and rode." data-ar="مشي، باص، باص سريع، كوستر أو سرفيس: أضف كل مرحلة مع وقت الانتظار والمشوار."></p></div>
          <div><b data-en="3 · See all trips" data-ar="٣ · شوف كل الرحلات"></b><p data-en="Your trip joins a live map of everyone's trips." data-ar="رحلتك بتنضاف لخريطة مباشرة لكل الرحلات."></p></div>
        </div>
        <p class="uj-note" data-en="No name, phone number or email is collected. Results will be published here, in aggregate, and shared with the people who run the buses."
           data-ar="ما بنجمع اسم ولا رقم هاتف ولا إيميل. النتائج بتنشر هون بشكل مجمّع، وبتوصل للجهات المسؤولة عن الباصات."></p>
      </div>

      <div class="uj-sec" id="maps">
        <span class="label" data-en="Maps" data-ar="الخرائط"></span>
        <h2 data-en="Free bus maps to the University of Jordan" data-ar="خرائط باصات مجانية للجامعة الأردنية"></h2>
        <p class="lede" data-en="Free for students and anyone else. Save the image on your phone, or print the PDF for a wall, a faculty or a club."
           data-ar="مجانية للطلاب ولأي حدا. احفظ الصورة على هاتفك، أو اطبع ملف الـPDF لجدار كلية أو نادي أو سكن."></p>
        <div class="uj-maps">
          {%- set maps = [
            ["amman-lines", "Amman lines to UJ", "خطوط عمّان للجامعة", "Amman Bus, BRT and Al-Mutakamela", "باص عمّان، الباص السريع، والمتكاملة"],
            ["governorate-lines", "From the governorates", "من المحافظات", "Irbid, Jerash, Ajloun, Salt and Tafileh", "إربد، جرش، عجلون، السلط، الطفيلة"],
            ["uj-campus-stops", "UJ campus stops", "محطات الجامعة", "Every stop on campus and the lines that use it", "كل محطة بالجامعة والخطوط اللي بتوقف عندها"]
          ] %}
          {%- for m in maps %}
          <div class="uj-map">
            <a href="/uploads/field/uj/map-{{ m[0] }}.jpg" target="_blank" rel="noopener"><img src="/uploads/field/uj/map-{{ m[0] }}-thumb.jpg" alt="{{ m[1] }}" loading="lazy" width="422" height="597"></a>
            <h3 data-en="{{ m[1] }}" data-ar="{{ m[2] }}"></h3>
            <p data-en="{{ m[3] }}" data-ar="{{ m[4] }}"></p>
            <div class="uj-map-btns">
              <a class="btn btn-primary btn-sm" href="/uploads/field/uj/map-{{ m[0] }}.jpg" download="mudun-uj-{{ m[0] }}.jpg" data-en="Image" data-ar="صورة"></a>
              <a class="btn btn-ghost btn-sm" href="/uploads/field/uj/print-{{ m[0] }}-A1.pdf" download data-en="PDF to print" data-ar="PDF للطباعة"></a>
            </div>
          </div>
          {%- endfor %}
        </div>
        <p class="uj-note" data-en="Updated November 2026. Routes change: check live buses and times in the Amman Bus app. Line data: Amman Vision. Base map © OpenStreetMap contributors."
           data-ar="محدّث: تشرين الثاني ٢٠٢٦. الخطوط ممكن تتغيّر: تابع الباصات والمواعيد مباشرة على تطبيق Amman Bus. بيانات الخطوط: رؤية عمّان. خريطة الأساس © مساهمو OpenStreetMap."></p>
      </div>

      <div class="uj-sec">
        <div class="uj-box">
          <span class="label" data-en="Results" data-ar="النتائج"></span>
          <h2 style="margin-top:.4rem" data-en="Coming after the booth" data-ar="بعد الجناح"></h2>
          <p data-en="Once enough trips are in, we will publish what they show: where students come from, how long they travel, how much of the trip is waiting, and where there is no line at all."
             data-ar="لما يتجمّع عدد كافي من الرحلات، بننشر شو بتبيّن: من وين جايين الطلاب، قدّيش بتطول رحلتهم، قدّيش منها انتظار، ووين ما في خط أصلاً."></p>
          <a class="btn btn-primary btn-sm" href="/uj/" style="margin-top:1rem"><span data-en="Add your trip" data-ar="أضف رحلتك"></span><span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>
